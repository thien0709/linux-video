# Text-to-speech provider: "cit" for local CIT Voice Studio, or "edge".
TTS_PROVIDER=cit
TTS_OUTPUT_DIR=public/audio

# CIT Voice Studio (local service). API key is optional for localhost.
CIT_TTS_BASE_URL=http://127.0.0.1:8001
CIT_TTS_API_KEY=
CIT_TTS_VOICE=Quốc Tuấn
CIT_TTS_SPEED=1.05
CIT_TTS_FORMAT=wav
# Optional CIT settings:
# CIT_TTS_TEMPERATURE=0.7
# CIT_TTS_SEED=
# CIT_TTS_LANGUAGE=vi
# CIT_TTS_USE_PRONUNCIATION_DICT=true
# CIT_TTS_TIMEOUT_SEC=120

# Edge TTS settings (used when TTS_PROVIDER=edge).
EDGE_TTS_VOICE=vi-VN-NamMinhNeural
EDGE_TTS_RATE=+10%
EDGE_TTS_PITCH=+0Hz
EDGE_TTS_VOLUME=+0%

# Channel label used by video assets or scripts when configured.
CHANNEL_NAME=NIIS
